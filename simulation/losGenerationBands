def export_for_ns3(out_dir, step_s, ships_enu_hist, uav_enu_hist, adj_l_hist, adj_ku_hist):
    """
    ships_enu_hist : list of (n_ships, 3) arrays - ship ENU *at placement time*
    uav_enu_hist   : list of (3,) arrays          - UAV ENU chosen for that step
    adj_l_hist     : list of (n_ships+1, n_ships+1) dense arrays - L-band LoS graph
                     for that step (ship-ship AND ship-UAV L links); UAV is the
                     last row/col; entry > 0 means a LoS link (value = distance, m)
    adj_ku_hist    : same shape as adj_l_hist, but the Ku-band graph (ship-UAV
                     Ku links only - ship-ship Ku is always 0 in this scenario)
    A ship-UAV pair can be nonzero in BOTH adj_l_hist and adj_ku_hist at once
    (both bands clear simultaneously); links.csv gets one row per band that's
    clear, so that pair, so ns-3 can bring up both radios independently.
    """
    n_steps = len(uav_enu_hist)
    assert len(ships_enu_hist) == n_steps == len(adj_l_hist) == len(adj_ku_hist), \
        "histories differ in length"
    n_ships = np.asarray(ships_enu_hist[0]).shape[0]
    os.makedirs(out_dir, exist_ok=True)

    with open(os.path.join(out_dir, "nodes.csv"), "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["step", "t_s", "node", "x", "y", "z"])
        for k in range(n_steps):
            t = k * step_s
            ships = np.asarray(ships_enu_hist[k], dtype=float)
            for n in range(n_ships):
                w.writerow([k, t, n, *ships[n]])
            w.writerow([k, t, n_ships, *np.asarray(uav_enu_hist[k], dtype=float)])

    n_edges_l = []
    n_edges_ku = []
    with open(os.path.join(out_dir, "links.csv"), "w", newline="") as f:
        w = csv.writer(f, lineterminator="\n")
        w.writerow(["step", "t_s", "i", "j", "band", "dist_m"])
        for k in range(n_steps):
            adj_l = np.asarray(adj_l_hist[k], dtype=float)
            adj_ku = np.asarray(adj_ku_hist[k], dtype=float)
            for name, adj in (("L", adj_l), ("Ku", adj_ku)):
                assert adj.shape == (n_ships + 1, n_ships + 1), \
                    f"{name}-band adjacency must include the UAV"
                if not np.array_equal(adj > 0, (adj > 0).T):
                    print(f"WARNING: step {k} {name}-band adjacency is not symmetric")
            cnt_l = 0
            cnt_ku = 0
            for i in range(n_ships + 1):
                for j in range(i + 1, n_ships + 1):
                    if adj_l[i, j] > 0:
                        w.writerow([k, k * step_s, i, j, "L", adj_l[i, j]])
                        cnt_l += 1
                    if adj_ku[i, j] > 0:
                        w.writerow([k, k * step_s, i, j, "Ku", adj_ku[i, j]])
                        cnt_ku += 1
            n_edges_l.append(cnt_l)
            n_edges_ku.append(cnt_ku)

    # Sanity report
    print(f"Exported {n_steps} steps, {n_ships} ships + 1 UAV -> {out_dir}/")
    print("L-band LoS edges per step: ", n_edges_l)
    print("Ku-band LoS edges per step:", n_edges_ku)
    uav = np.asarray(uav_enu_hist, dtype=float)
    if n_steps > 1:
        jump = np.linalg.norm(np.diff(uav, axis=0), axis=1)
        print(f"UAV displacement between steps: max {jump.max()/1000:.1f} km "
              f"-> implied speed {jump.max()/step_s:.0f} m/s "
              f"({jump.max()/step_s*1.944:.0f} kn)")

