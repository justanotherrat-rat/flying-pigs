# metrics helpers---------------------------------------------------------

def _network_metrics(adjacency):
    """Return connectivity and two-hop coverage metrics for a dense LoS matrix."""
    direct = np.asarray(adjacency) > 0
    np.fill_diagonal(direct, False)
    n_nodes = direct.shape[0]

    if n_nodes <= 1:
        return {
            'components': 1,
            'max_hops': 0,
            'pairs_within_two_hops': 0,
            'total_pairs': 0,
            'direct_edges': 0,
        }

    hop_adjacency = csr_matrix(direct.astype(np.int8))
    distances = shortest_path(hop_adjacency, directed=False, unweighted=True)
    pair_distances = distances[np.triu_indices(n_nodes, k=1)]
    finite_distances = pair_distances[np.isfinite(pair_distances)]
    total_pairs = len(pair_distances)

    return {
        'components': connected_components(
            hop_adjacency,
            directed=False,
            return_labels=False),
        'max_hops': int(
            np.max(finite_distances)) if len(finite_distances) else np.inf,
        'pairs_within_two_hops': int(
                np.count_nonzero(
                    pair_distances <= 2)),
        'total_pairs': total_pairs,
        'direct_edges': int(
            np.count_nonzero(
                np.triu(
                    direct,
                    k=1))),
    }


def _midpoint_seed(ships_enu, altitude_m):
    """Create the single midpoint seed for the UAV search."""
    centre = np.mean(ships_enu[:, :2], axis=0)
    return np.array([centre[0], centre[1], altitude_m], dtype=float)


def place_uavs(ships_enu, dem_dataset, lat_ref_deg, lon_ref_deg,
               min_alt_m=1500.0, max_alt_m=6100.0,
               maxiter=35, popsize=8,
               random_state=7, time_budget_s=10.0,
               previous_uav_enu=None, travel_time_minutes=None,
               uav_speed_kmh=130.0):
    """Place one UAV, stopping at the deadline and returning the best candidate."""
    import time

    if not np.isfinite(uav_speed_kmh) or uav_speed_kmh <= 0:
        raise ValueError('uav_speed_kmh must be a positive finite number')
    if previous_uav_enu is not None:
        previous_uav_enu = np.asarray(previous_uav_enu, dtype=float)
        if previous_uav_enu.shape != (3,):
            raise ValueError('previous_uav_enu must have shape (3,)')
        if (travel_time_minutes is None or
                not np.isfinite(travel_time_minutes) or travel_time_minutes < 0):
            raise ValueError(
                'travel_time_minutes must be finite and non-negative when '
                'previous_uav_enu is provided')
        max_travel_distance_m = (
            uav_speed_kmh * 1000.0 * travel_time_minutes / 60.0
        )
    else:
        max_travel_distance_m = None

    seed_alt_m = min_alt_m

    ships_enu = np.asarray(ships_enu, dtype=float)
    if ships_enu.ndim != 2 or ships_enu.shape[1] != 3:
        raise ValueError('ships_enu must have shape (n_ships, 3)')
    if len(ships_enu) == 0:
        raise ValueError('ships_enu must contain at least one ship')

    horizontal_min = np.min(ships_enu[:, :2], axis=0)
    horizontal_max = np.max(ships_enu[:, :2], axis=0)
    horizontal_span = np.maximum(horizontal_max - horizontal_min, 1000.0)
    margin = 0.15 * horizontal_span
    bounds = [
        (horizontal_min[0] - margin[0], horizontal_max[0] + margin[0]),
        (horizontal_min[1] - margin[1], horizontal_max[1] + margin[1]),
        (min_alt_m, max_alt_m),
    ]
    deadline = time.perf_counter() + max(0.0, time_budget_s)
    best = {'score': np.inf, 'position': None, 'graph_l': None, 'graph_ku': None,
            'graph': None, 'metrics': None, 'travel_distance_m': None,
            'travel_excess_m': 0.0}

    # objective function to be minimized for optimization
    def evaluate(position):
        if time.perf_counter() >= deadline:
            raise TimeoutError
        uav_enu = np.asarray(position, dtype=float).reshape(1, 3)
        all_coords = np.vstack((ships_enu, uav_enu))
        graph_l, graph_ku = build_dual_band_graph(
            all_coords, dem_dataset, lat_ref_deg, lon_ref_deg, n_ships=len(ships_enu))
        # For placement scoring/connectivity, a hop exists if EITHER band is
        # up - the UAV now reaches ships on whichever of its two radios has
        # LoS, so "the UAV is unreachable from ship i" should only be true
        # when BOTH bands are down to that ship.
        graph = graph_l.maximum(graph_ku)
        adjacency = graph.toarray()
        metrics = _network_metrics(adjacency)
        missing_two_hop_pairs = metrics['total_pairs'] - \
            metrics['pairs_within_two_hops']
        distances = shortest_path(graph, directed=False, unweighted=True)
        pair_distances = distances[np.triu_indices(len(all_coords), k=1)]
        disconnected_pairs = np.count_nonzero(~np.isfinite(pair_distances))
        travel_distance_m = None
        travel_excess_m = 0.0
        travel_penalty = 0.0
        if previous_uav_enu is not None:
            travel_distance_m = float(
                np.linalg.norm(uav_enu[0] - previous_uav_enu)
            )
            travel_excess_m = max(
                0.0, travel_distance_m - max_travel_distance_m
            )
            if travel_excess_m > 1e-6:
                # Prefer any reachable placement; among unreachable candidates,
                # favor the smallest travel shortfall.
                travel_penalty = 1e9 + 1000.0 * travel_excess_m
        # Keep connectivity as the priority; among equivalent networks, prefer
        # shorter active UAV-to-ship links (the union graph counts each once).
        uav_link_length_km = np.sum(adjacency[-1, :len(ships_enu)]) / 1000.0
        score = (100000.0 * disconnected_pairs +
                 10000.0 * missing_two_hop_pairs +
                 uav_link_length_km +
                 travel_penalty)
        if score < best['score']:
            best.update(
                score=score,
                position=uav_enu.copy(),
                graph_l=graph_l,
                graph_ku=graph_ku,
                graph=graph,
                metrics=metrics,
                travel_distance_m=travel_distance_m,
                travel_excess_m=travel_excess_m)
        return score

    midpoint_seed = _midpoint_seed(
        ships_enu,
        float(np.clip(seed_alt_m, min_alt_m, max_alt_m)),
    )
    try:
        evaluate(midpoint_seed)
        differential_evolution(
            evaluate,
            bounds=bounds,
            x0=midpoint_seed,
            maxiter=maxiter,
            popsize=popsize,
            polish=False,
            seed=random_state,
            updating='immediate',
            workers=1,
        )
    except TimeoutError:
        pass

    if best['position'] is None:
        raise TimeoutError(
            'UAV placement budget expired before a candidate was evaluated')

    uav_enu = best['position'].reshape(3)
    graph_l = best['graph_l']
    graph_ku = best['graph_ku']
    graph = best['graph']  # union of both bands, kept for existing plotting code
    metrics = best['metrics']
    uav_lat, uav_lon, uav_alt = enu_to_lla(
        uav_enu[0], uav_enu[1], uav_enu[2], lat_ref_deg, lon_ref_deg, 0.0
    )
    # visible via EITHER band (used by plot2D_with_uav to draw a ship-UAV
    # line; it doesn't distinguish which band, so any connectivity counts)
    visible_ships = np.flatnonzero(
        graph.toarray()[-1, :len(ships_enu)] > 0
    ).tolist()
    uav = {
        'uav_lla': np.array([uav_lat, uav_lon, uav_alt]),
        'uav_enu': uav_enu,
        'visible_ships': visible_ships,
    }

    return {
        'uavs': [uav],
        'uav_lla': uav['uav_lla'],
        'visible_ships': visible_ships,
        'network_metrics': metrics,
        'feasible_with_max_uavs': metrics['components'] == 1 and metrics['max_hops'] <= 2,
        'augmented_graph': graph,     # union of L and Ku - unchanged shape/meaning for old callers
        'graph_l': graph_l,           # L-band-only graph (ship-ship + ship-UAV L links)
        'graph_ku': graph_ku,         # Ku-band-only graph (ship-UAV Ku links)
        'timed_out': time.perf_counter() >= deadline,
        'travel_distance_m': best['travel_distance_m'],
        'max_travel_distance_m': max_travel_distance_m,
        'travel_feasible': best['travel_excess_m'] <= 1e-6,
    }

# ship movement helpers---------------------------------------------------


def generate_individual_movements(
        speed=10,
        speed_spread=1.0,
        heading=135,
        heading_spread=30,
        n_ships=7):
    '''
    Generates individual speeds and headings for each ship within the convoy spread
    Returns: arrays: individual_speeds_knots, individual_headings_deg
    '''
    individual_speeds_knots = np.random.uniform(
        speed - speed_spread, speed + speed_spread, n_ships)
    individual_headings_deg = np.random.uniform(
        heading - heading_spread, heading + heading_spread, n_ships)

    return individual_speeds_knots, individual_headings_deg


def update_ship_positions_lla(
        current_lla,
        speeds_knots,
        headings_deg,
        time_step_minutes=5):
    """
    Updates ship LLA positions based on individual speeds, headings, and time step. Approximation suitable for relatively short distances.
    Returns: np.ndarray: New LLA coordinates for all ships.
    """
    new_lla = np.copy(current_lla)

    # Convert time step from minutes to seconds
    time_step_seconds = time_step_minutes * 60

    # Approximate Earth's radius (mean radius)
    EARTH_RADIUS = 6371000  # meters

    for i in range(len(current_lla)):
        speed_knots = speeds_knots[i]
        heading_deg = headings_deg[i]

        # Convert speed from knots to meters per second
        speed_mps = speed_knots * 0.514444  # 1 knot = 0.514444 m/s

        # Distance moved in this time step (meters)
        distance_m = speed_mps * time_step_seconds

        # Convert heading to radians (0=North, clockwise positive)
        heading_rad = np.radians(90 - heading_deg)

        lat_deg, lon_deg, alt_m = current_lla[i,
                                              0], current_lla[i, 1], current_lla[i, 2]
        lat_rad = np.radians(lat_deg)

        # Calculate change in latitude and longitude

        # North component of movement
        delta_lat_m = distance_m * np.sin(heading_rad)
        # East component of movement
        delta_lon_m = distance_m * np.cos(heading_rad)

        # Convert meter changes to degree changes
        delta_lat_deg = np.degrees(delta_lat_m / EARTH_RADIUS)
        delta_lon_deg = np.degrees(
            delta_lon_m / (EARTH_RADIUS * np.cos(lat_rad)))

        new_lla[i, 0] = lat_deg + delta_lat_deg
        new_lla[i, 1] = lon_deg + delta_lon_deg
        # Altitude constant
        new_lla[i, 2] = alt_m

    return new_lla

